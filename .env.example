# Engineering Knowledge Graph Configuration

# Groq API Key for LLM-powered query understanding
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=""

# Optional: OpenAI API key for enhanced natural language processing
# OPENAI_API_KEY=your_openai_api_key_here

# Server configuration
HOST=0.0.0.0
PORT=8000

# Data directory (relative to project root)
DATA_DIR=data

# PostgreSQL Database Configuration
# Production-grade authentication and session management
DATABASE_URL=postgresql://ekg_user:ekg_password@localhost:5432/ekg_db
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Neo4j Configuration (optional - for production deployment)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password_here
